# Template de atendimento — copie para .env e preencha antes do primeiro `docker compose up`.
# Nunca envie este arquivo preenchido ao GitHub.

# --- OBRIGATÓRIO: segurança ---
# Gere com: openssl rand -hex 32
API_SERVER_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Gere uma senha longa e única. O compose recusa senha vazia ou admin123.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE

# --- OBRIGATÓRIO: dono da instalação ---
# Formato internacional, apenas dígitos, sem +. O valor abaixo é fictício.
WHATSAPP_OWNER_NUMBER=5511999999999
WHATSAPP_OWNER_NAME=Nome do responsavel
WHATSAPP_BUSINESS_NAME=Nome da empresa atendida
WHATSAPP_ASSISTANT_NAME=Nome do atendimento
WHATSAPP_CONNECTION_NAME=Atendimento do cliente
WHATSAPP_ENABLED=false

# --- OBRIGATÓRIO: escolha UM provider ---
# Preencha apenas a chave do provider escolhido.
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Código público; não exige login do GitHub na VPS ---
HERMES_SETUP_GITHUB_USER=raizandu
HERMES_SETUP_GITHUB_REPO=whatsaya-template
HERMES_SETUP_GITHUB_REF=main
WHATSAPP_CONFIG_SUBDIR=generic
KEEP_LOCAL_PLUGIN=false

# --- Comportamento do WhatsApp ---
WHATSAPP_MODE=bot
WHATSAPP_ALLOWED_USERS=*
WHATSAPP_GROUPS_ENABLED=false
WHATSAPP_REJECT_CALLS=false
WHATSAPP_SEND_READ_RECEIPTS=true
WHATSAPP_DEBOUNCE_INITIAL_MS=8000
WHATSAPP_DEBOUNCE_MIN_MS=1500
WHATSAPP_DEBOUNCE_DECAY=0.6
WHATSAPP_DEBOUNCE_SKIP_SELF_CHAT=true
WHATSAPP_DEBOUNCE_TYPING_REFRESH_MS=5000
# O debounce já controla a espera; não empilhe o atraso legado.
WHATSAPP_FIRST_RESPONSE_DELAY_S=0

# Chave de pagamento: deixe vazia se não houver venda direta no WhatsApp.
WHATSAPP_PIX_KEY=

# --- Modelos e limites ---
WHATSAPP_OWNER_MODEL=gpt-5.6-luna
WHATSAPP_OWNER_PROVIDER=openai-codex
WHATSAPP_OWNER_REASONING_EFFORT=high
WHATSAPP_CLIENT_MODEL=gpt-5.6-terra
WHATSAPP_CLIENT_PROVIDER=openai-codex
WHATSAPP_CLIENT_REASONING_EFFORT=medium
MAX_TURNS=8

# --- Opcionais ---
TZ=America/Sao_Paulo
HERMES_IMAGE_TAG=v2026.7.20
FISH_API_KEY=
FISH_REFERENCE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dados do cliente ficam no volume local por padrão. Só preencha os dois campos
# abaixo se houver uma decisão explícita de usar um repositório PRIVADO separado.
CONFIG_REPO=
CONFIG_GITHUB_TOKEN=

# Metadados comerciais opcionais de campanhas Click-to-WhatsApp, em JSON.
WHATSAPP_LEAD_CAMPAIGN_METADATA_JSON=
